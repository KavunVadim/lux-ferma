{
  "name": "lux-ferma",
  "private": true,
  "version": "0.1.0",
  "description": "Люкс Ферма — помічник для настільної гри: кубики, розмноження тварин, хижаки та обмін",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --force",
    "lint": "oxlint",
    "assets": "node scripts/optimize-assets.mjs",
    "atlas": "node scripts/build-atlas.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "check:settings": "node scripts/check-settings.mjs",
    "check:sound": "node scripts/check-sound.mjs",
    "check:perf": "node scripts/check-performance.mjs",
    "check:walk": "node scripts/check-walk.mjs",
    "check:frames": "node scripts/check-frames.mjs",
    "check:spread": "node scripts/check-spread.mjs",
    "check:animals": "node scripts/check-animals.mjs",
    "check:undo": "node scripts/check-undo.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:dark": "node scripts/check-dark.mjs",
    "check:all": "npm run typecheck && npm run lint && npm run test && npm run check:settings && npm run check:sound && npm run check:frames && npm run check:spread && npm run check:undo && npm run check:contrast && npm run check:dark",
    "art:status": "node scripts/art-status.mjs",
    "shot:start": "node scripts/shot-start.mjs",
    "shot:board": "node scripts/shot-board.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "cap:android": "npm run build && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
